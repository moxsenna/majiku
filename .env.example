# ===================================================
# MAJIKU Production & Development Environment Variables
# ===================================================

# Neon Postgres (HTTP Serverless driver)
NEON_DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_DATABASE_URL_DIRECT="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# BetterAuth
BETTER_AUTH_SECRET="your-32-character-random-secret-key"
BETTER_AUTH_URL="https://majiku.web.id"

# Site Public URL
NEXT_PUBLIC_SITE_URL="https://majiku.web.id"

# PayCore Payment Gateway
PAYMENTS_ENABLED="true"
PAYMENT_MODE="live"
PAYCORE_ENVIRONMENT="production"
PAYCORE_BASE_URL="https://api.paycore.id"
PAYCORE_APP_ID="your_paycore_app_id"
PAYCORE_KEY_ID="your_paycore_key_id"
PAYCORE_APP_SECRET="your_paycore_app_secret"
PAYCORE_WEBHOOK_SECRET="your_paycore_webhook_secret"
PAYCORE_RETURN_URL="https://majiku.web.id/payment/return"

# Cloudflare R2 Bucket Binding (diatur di wrangler.jsonc)
# PHOTOS_BUCKET="majiku-photos"
